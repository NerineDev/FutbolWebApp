38951>>>        tWebNavigateData NavigateData
38951>>>        tWebNavigateData NavigateData
38951>>>        Boolean bHasRecord
38951>>>        Handle hoDD
38951>>>
38951>>>        Get Server to hoDD
38952>>>        Get GetNavigateData to NavigateData
38953>>>        Get HasRecord of hoDD to bHasRecord
38954>>>
38954>>>        // let's hide all buttons and then Show the ones we want
38954>>>        WebSet pbRender of oEditBtn to False
38955>>>        WebSet pbRender of oSaveBtn to False
38956>>>        WebSet pbRender of oCancelChangesBtn to False
38957>>>        WebSet pbRender of oDeleteBtn to False
38958>>>
38958>>>        If (NavigateData.bReadOnly) Begin
38960>>>            WebSet pbRender of oEditBtn to True
38961>>>        End
38961>>>>
38961>>>        Else Begin
38962>>>            WebSet pbRender of oSaveBtn to True
38963>>>            WebSet pbRender of oCancelChangesBtn to True
38964>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38965>>>        End
38965>>>>
38965>>>    End_Procedure

38998>>>    Procedure SetActionButtons
39001>>>        tWebNavigateData NavigateData
39001>>>        tWebNavigateData NavigateData
39001>>>        Boolean bHasRecord
39001>>>        Handle hoDD
39001>>>
39001>>>        Get Server to hoDD
39002>>>        Get GetNavigateData to NavigateData
39003>>>        Get HasRecord of hoDD to bHasRecord
39004>>>
39004>>>        // let's hide all buttons and then Show the ones we want
39004>>>        WebSet pbRender of oEditBtn to False
39005>>>        WebSet pbRender of oSaveBtn to False
39006>>>        WebSet pbRender of oCancelChangesBtn to False
39007>>>        WebSet pbRender of oDeleteBtn to False
39008>>>
39008>>>        If (NavigateData.bReadOnly) Begin
39010>>>            WebSet pbRender of oEditBtn to True
39011>>>        End
39011>>>>
39011>>>        Else Begin
39012>>>            WebSet pbRender of oSaveBtn to True
39013>>>            WebSet pbRender of oCancelChangesBtn to True
39014>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39015>>>        End
39015>>>>
39015>>>    End_Procedure

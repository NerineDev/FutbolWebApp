Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  
    // Add a DDO Structure 
    //
    // There is no need to synchronize a DD structure on the client so we do
    // not set the Server property or send ADDOStructure. We will simply use
    // DDO's to mine data and generate HTML for our cWebHTMLBox objects.
    // It is the HTML in these objects that is sent to the client each time 
    // this page is shown.
    //
    // Also, it is important for the drill-down Navigation interface that we
    // do not set the Server property to some DDO because this will affect 
    // constraints in the next view that we navigate to.
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

    Set piMaxWidth to 1180
    
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        Set psCSSClass to "SoccerDashboardPanel"
        
        // - - - - - - - - - - - - - - -
        // Main Panel's Responsive Rules
        // - - - - - - - - - - - - - - -
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16
    
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 24
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 24
            
            Set psCSSClass to "TilesGroup"
    
            Object oWelcomeTile is a cWebHtmlBox
                Set piColumnSpan to 24
                Set psCSSClass to "SoccerHero"
                Set psHtml to '<div style="min-height:220px;border-radius:16px;padding:34px 40px;margin-bottom:22px;color:#fff;background:linear-gradient(135deg,#10201a 0%,#14532d 52%,#0b2f24 100%);box-shadow:0 18px 40px rgba(15,23,42,.18);position:relative;overflow:hidden;"><div style="max-width:690px;position:relative;z-index:2;"><div style="display:inline-block;margin-bottom:12px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.12);color:#d9f99d;font-size:12px;font-weight:800;text-transform:uppercase;">Gestion de club y competicion</div><div style="margin-bottom:12px;font-size:46px;line-height:1;font-weight:900;">Futbol WebApp</div><div style="max-width:650px;color:#e0f2fe;font-size:17px;line-height:1.55;">Bienvenido.<br>Tu tablero para moverte rapido entre ligas, equipos, jugadores, entrenadores y posiciones.</div></div><div style="position:absolute;right:62px;top:36px;width:160px;height:150px;display:flex;align-items:center;justify-content:center;"><img src="Images/app-logo.png" alt="" style="width:150px;height:150px;object-fit:contain;display:block;" /></div></div>'
    
                Procedure OnLoad
                    Send UpdateHTML ('<div style="min-height:220px;border-radius:16px;padding:34px 40px;margin-bottom:22px;color:#fff;background:linear-gradient(135deg,#10201a 0%,#14532d 52%,#0b2f24 100%);box-shadow:0 18px 40px rgba(15,23,42,.18);position:relative;overflow:hidden;">' + ;
                                     '<div style="max-width:700px;position:relative;z-index:2;">' + ;
                                     '<div style="display:inline-block;margin-bottom:12px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.12);color:#d9f99d;font-size:12px;font-weight:800;text-transform:uppercase;">Gestion de club y competicion</div>' + ;
                                     '<div style="margin-bottom:12px;font-size:46px;line-height:1;font-weight:900;">Futbol WebApp</div>' + ;
                                     '<div style="max-width:650px;color:#e0f2fe;font-size:17px;line-height:1.55;">Bienvenido, ' - htmlEncode(psUserName(ghoWebSessionManager)) - '.<br>Tu tablero para moverte rapido entre ligas, equipos, jugadores, entrenadores y posiciones.</div>' + ;
                                     '</div>' + ;
                                     '<div style="position:absolute;right:62px;top:36px;width:160px;height:150px;display:flex;align-items:center;justify-content:center;"><img src="Images/app-logo.png" alt="" style="width:150px;height:150px;object-fit:contain;display:block;" /></div>' + ;
                                     '</div>')
                End_Procedure
                
            End_Object
    
            Object oEntrenador_Tile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 8
                Set psCSSClass to "SoccerTile SoccerTile_Staff"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:170px;padding:26px 24px;border-radius:14px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#123f2b,#071f18);box-shadow:0 14px 30px rgba(15,23,42,.14);"><div style="width:82px;height:82px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;overflow:hidden;"><img src="Images/entrenador.png" alt="" style="width:76px;height:76px;object-fit:contain;display:block;" /></div><div style="margin-bottom:8px;font-size:24px;font-weight:850;">Entrenadores</div><div style="color:rgba(255,255,255,.78);font-size:14px;">Gestion tecnica de los equipos</div></div>'
                                
                WebRegisterPath ntNavigateForwardCustom oSelectEntrenador
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
    
            Object oJugadores_Tile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 8
                Set piColumnIndex to 8
                Set psCSSClass to "SoccerTile SoccerTile_Player"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:170px;padding:26px 24px;border-radius:14px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#167047,#0e3b31);box-shadow:0 14px 30px rgba(15,23,42,.14);"><div style="width:82px;height:82px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;overflow:hidden;"><img src="Images/jugador.png" alt="" style="width:76px;height:76px;object-fit:contain;display:block;" /></div><div style="margin-bottom:8px;font-size:24px;font-weight:850;">Jugadores</div><div style="color:rgba(255,255,255,.78);font-size:14px;">Planteles, datos y detalle individual</div></div>'
    
                WebRegisterPath ntNavigateForwardCustom oSelectJugador
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
    
            Object oEquipos_Tile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 8
                Set piColumnIndex to 16
                Set psCSSClass to "SoccerTile SoccerTile_Team"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:170px;padding:26px 24px;border-radius:14px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f766e,#0b302b);box-shadow:0 14px 30px rgba(15,23,42,.14);"><div style="width:82px;height:82px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;overflow:hidden;"><img src="Images/equipo.png" alt="" style="width:76px;height:76px;object-fit:contain;display:block;" /></div><div style="margin-bottom:8px;font-size:24px;font-weight:850;">Equipos</div><div style="color:rgba(255,255,255,.78);font-size:14px;">Clubes asociados a cada liga</div></div>'
            
                WebRegisterPath ntNavigateForwardCustom oSelectEquipo
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
            
            
            Object oLigas_Tile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set psCSSClass to "SoccerTile SoccerTile_League"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:170px;padding:26px 24px;border-radius:14px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#15803d,#0a2f22);box-shadow:0 14px 30px rgba(15,23,42,.14);"><div style="width:82px;height:82px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;overflow:hidden;"><img src="Images/liga.png" alt="" style="width:76px;height:76px;object-fit:contain;display:block;" /></div><div style="margin-bottom:8px;font-size:24px;font-weight:850;">Ligas</div><div style="color:rgba(255,255,255,.78);font-size:14px;">Competencias, paises y cupos</div></div>'
            
                WebRegisterPath ntNavigateForwardCustom oSelectLiga
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
            
            Object oPosiciones_Tile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 12
                Set psCSSClass to "SoccerTile SoccerTile_Position"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:170px;padding:26px 24px;border-radius:14px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f8175,#102323);box-shadow:0 14px 30px rgba(15,23,42,.14);"><div style="width:82px;height:82px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;overflow:hidden;"><img src="Images/posicion.png" alt="" style="width:76px;height:76px;object-fit:contain;display:block;" /></div><div style="margin-bottom:8px;font-size:24px;font-weight:850;">Posiciones</div><div style="color:rgba(255,255,255,.78);font-size:14px;">Roles dentro del campo de juego</div></div>'
            
                WebRegisterPath ntNavigateForwardCustom oSelectPosicion
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
            
            
            
        End_Object
    
    End_Object
    
    Procedure OnBeforeShow
        // Each time this view is shown we will update the appropriate information.
    End_Procedure

End_Object

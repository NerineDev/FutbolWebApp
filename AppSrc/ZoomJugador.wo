// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomJugador.wo
// Jugador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebHtmlBox.pkg
Use cWebTabContainer.pkg
Use cWebTabPage.pkg
Use SQL.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd


Object oZoomJugador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD
    End_Object 

    Object oSQLHandleManager is a cSQLHandleManager
    End_Object

    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 4
            Set piColumnIndex to 1
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 

        Object ojugadorApellido is a cWebForm
            Entry_Item jugador.Apellido
            Set piColumnSpan to 4
            Set piColumnIndex to 7
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
        End_Object 
        WebSetResponsive piColumnCount rmMobile to 4

        Object ojugadorNacionalidad is a cWebForm
            Entry_Item jugador.Nacionalidad
            Set piColumnSpan to 4
            Set piColumnIndex to 1
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
        End_Object 

        Object oPosicionesBox is a cWebHtmlBox
            Set piColumnSpan to 4
            Set piColumnIndex to 7
            Set psHtml to ""
        End_Object

        Object oEditarPosicionesButton is a cWebButton
            Set piColumnSpan to 4
            Set piColumnIndex to 7
            Set psCaption to "Editar posiciones"

            WebRegisterPath ntNavigateForward oSelectJugadorPosicion

            Procedure OnClick
                Send NavigatePath
            End_Procedure
        End_Object

        Object oWebTabContainer is a cWebTabContainer
            Set pbFillHeight to True
            Set piColumnSpan to 12
            Set pbShowLabel to False

            Object oPage1 is a cWebTabPage
                Set piColumnCount to 12
                Set psCaption to "Equipo y Liga"

                Object oequipoNombre is a cWebForm
                    Entry_Item equipo.Nombre
                    Set piColumnSpan to 5
                    Set piColumnIndex to 0
                    Set peLabelPosition to lpTop
                    Set psLabel to "Equipo"
                    Set pbPromptButton to True

// ToDo: Fill in the from-child parent Select view object name for navigate forward
                    WebRegisterPath ntNavigateForward oSelectEquipo

                    Procedure OnPrompt
                        Send NavigatePath
                    End_Procedure
                End_Object 

                Object oligaNombre is a cWebForm
                    Entry_Item liga.Nombre
                    Set piColumnSpan to 3
                    Set piColumnIndex to 6
                    Set peLabelPosition to lpTop
                    Set psLabel to "Liga"
                    Set pbPromptButton to True

// ToDo: Fill in the from-child parent Select view object name for navigate forward
                    WebRegisterPath ntNavigateForward oSelectLiga

                    Procedure OnPrompt
                        Send NavigatePath
                    End_Procedure
                End_Object 
                WebSetResponsive piColumnCount rmMobile to 4

                Object oligaPais is a cWebForm
                    Entry_Item liga.Pais
                    Set piColumnSpan to 4
                    Set piColumnIndex to 0
                    Set peLabelPosition to lpTop
                    Set psLabel to "Pais"
                End_Object 
            End_Object 
        End_Object 
    End_Object 

    Object oActionGroup is a cWebMenuGroup
        Set psGroupName to "MainActions"
        
            Object oBackBtn is a cWebMenuItem

                Set psCaption to "Back"
                Set peActionDisplay to adBoth
                Set psImage to "Images/back-green.svg"
            
            Procedure OnClick
                Send NavigateCancel Self
            End_Procedure

        End_Object

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oFireBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Despedir"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Clear of oequipo_DD
            End_Procedure

        End_Object

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False
        WebSet pbRender of oFireBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
            WebSet pbRender of oEditarPosicionesButton to bHasRecord
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
            WebSet pbRender of oFireBtn to bHasRecord
            WebSet pbRender of oEditarPosicionesButton to bHasRecord
        End
    End_Procedure

    Function PosicionesHtml Integer iJugadorId Returns String
        Handle hoConnection hoStatement
        Integer iFetchResult iRows
        String sNombre sSQL sHtml

        Move '<div style="padding-top:2px;"><div style="margin-bottom:6px;color:#fff;font-size:13px;font-weight:700;">Posiciones</div><div style="min-height:36px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' to sHtml

        If (iJugadorId <> 0) Begin
            Move ("select p.Nombre from jugadorposicion jp inner join posicion p on p.ID = jp.PosicionID where jp.JugadorID = " + String(iJugadorId) + " order by p.Nombre") to sSQL

            Get SQLFileConnect of oSQLHandleManager jugadorposicion.File_Number to hoConnection
            If (hoConnection <> 0) Begin
                Get SQLOpen of hoConnection to hoStatement
                If (hoStatement <> 0) Begin
                    Send SQLExecDirect of hoStatement sSQL
                    Repeat
                        Get SQLFetch of hoStatement to iFetchResult
                        If (iFetchResult <> 0) Begin
                            Get SQLColumnValue of hoStatement 1 to sNombre
                            Move (sHtml + '<span style="display:inline-flex;align-items:center;border-radius:999px;background:rgba(16,110,75,.88);color:#fff;padding:5px 11px;font-size:13px;font-weight:700;box-shadow:0 3px 10px rgba(0,0,0,.18);">' + sNombre + '</span>') to sHtml
                            Increment iRows
                        End
                    Until (iFetchResult = 0)
                    Send SQLClose to hoStatement
                End
                Send SQLDisconnect to hoConnection
            End
        End

        If (iRows = 0) Begin
            Move (sHtml + '<span style="color:rgba(255,255,255,.75);font-size:13px;">Sin posiciones</span>') to sHtml
        End

        Move (sHtml + '</div></div>') to sHtml
        Function_Return sHtml
    End_Function

    Procedure LoadJugadorPosiciones
        String sHtml

        Get PosicionesHtml jugador.ID to sHtml
        Send UpdateHTML of oPosicionesBox sHtml
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a propbably a main file Select to Zoom.
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent Zoom from a Zoom.
                Case Break

            Case Else // must be nfUndefined

        Case End

        Send SetActionButtons
        Send LoadJugadorPosiciones

    End_Procedure

End_Object 
